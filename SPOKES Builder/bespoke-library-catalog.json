  "wizardIntegration": {
    "load": "Fetch or import SPOKES Builder/bespoke-library-catalog.json",
    "display": "Render families.cards / dividers / titleSlides (and optionally textures, colorLeads) as selectable tiles",
    "persist": "Write chosen slug (not full id) into theme-registry.json fields and content-intake theme section",
    "emitCss": "Copy matching commented block from theme-library.css into style#theme-override; apply SCOPE / DIVIDER_SCOPE replacements",
    "chapterVary": "D12 opt-in: assign different cards.* slugs per chapterStyles entry; enforce THM-04 (no adjacent chapter same card style)",
    "doNot": [
      "Rewrite colorLead CSS or invent palette hex values",
      "Change canonical :root 11-color variables",
      "Invent CSS outside theme-library.css for lesson builds"
    ]
  }
