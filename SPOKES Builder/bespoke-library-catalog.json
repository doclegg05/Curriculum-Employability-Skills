{
  "version": "1.0.0",
  "product": "bespoke",
  "description": "Selectable SPOKES theme-library options for the Bespoke wizard catalog. IDs are stable; CSS lives in theme-library.css. Color leads are listed for catalog display only — do not rewrite the colorLead/registry color model.",
  "sourceCss": "SPOKES Builder/theme-library.css",
  "sourceRegistry": "SPOKES Builder/theme-registry.json",
  "idScheme": {
    "pattern": "{family}.{slug}",
    "slugRules": "kebab-case; matches the --- N. {slug} --- marker comment in theme-library.css",
    "registryFieldMap": {
      "cards": "chapterStyles.*.cards",
      "dividers": "chapterStyles.*.divider (and lesson-level dividerStyle)",
      "titleSlides": "titleSlide",
      "backgroundTextures": "backgroundTexture",
      "colorLeads": "colorLead",
      "sidebarColors": "sidebarColor",
      "fontPairings": "fontPairing"
    },
    "applyTokens": {
      "cards": "Replace SCOPE with [data-chapter=\"N\"]",
      "dividers": "Replace DIVIDER_SCOPE with .slide-section[data-chapter=\"N\"]",
      "titleSlides": "Uncomment block into style#theme-override (no SCOPE token)",
      "backgroundTextures": "Uncomment .main block into style#theme-override"
    }
  },
  "presets": [
    "Professional",
    "Modern",
    "Serious",
    "Light-hearted",
    "Fun",
    "Outspoken"
  ],
  "families": {
