  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Visible save and review actions, with the existing dark-blue hover.",
      "html": "<div class=\"ds-root\"><button class=\"ds-button ds-primary\" type=\"button\">Save shared design</button></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-button{display:inline-flex;justify-content:center;align-items:center;min-height:40px;padding:8px 12px;border:1px solid var(--line,#cad5df);border-radius:6px;font:500 .9rem/1.2 \"Outfit\",system-ui,sans-serif;cursor:pointer}.ds-button:disabled{opacity:.5;cursor:default}.ds-primary{background:var(--blue,#004071);border-color:var(--blue,#004071);color:var(--paper,#fff)}.ds-primary:hover{background:var(--navy,#00133f)}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}@media(max-width:760px){.ds-button{min-height:44px;padding:8px;font-size:.75rem}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Open, backup, and navigation actions.",
      "html": "<div class=\"ds-root\"><button class=\"ds-button ds-secondary\" type=\"button\">Open team design</button></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-button{display:inline-flex;justify-content:center;align-items:center;min-height:40px;padding:8px 12px;border:1px solid var(--line,#cad5df);border-radius:6px;font:500 .9rem/1.2 \"Outfit\",system-ui,sans-serif;cursor:pointer}.ds-button:disabled{opacity:.5;cursor:default}.ds-secondary{background:var(--paper,#fff);color:var(--navy,#00133f)}.ds-secondary:hover{background:var(--mist,#edf3f7)}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}@media(max-width:760px){.ds-button{min-height:44px;padding:8px;font-size:.75rem}}"
    },
    {
      "name": "Inline action",
      "kind": "button",
      "refersTo": "text-link",
      "description": "An underlined recovery or repair action in surrounding copy.",
      "html": "<div class=\"ds-root\"><button type=\"button\" class=\"ds-link\">Go to color controls</button></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-link{border:0;padding:0;background:transparent;text-decoration:underline;text-underline-offset:3px;color:var(--blue,#004071);font:inherit;cursor:pointer}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "A label above an editable text field; native inputs retain their semantics.",
      "html": "<div class=\"ds-root\"><label class=\"ds-field\">Sample title<input value=\"Make room for your next step\"></label></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-field{display:flex;flex-direction:column;gap:7px;font-size:.87rem;font-weight:500;margin-bottom:20px;max-width:340px}.ds-field input{font:.93rem \"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f);font-weight:400;width:100%;padding:10px;border:1px solid #8f9eaf;border-radius:5px;background:var(--paper,#fff);min-height:43px}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    },
    {
      "name": "Editor stage commands",
      "kind": "nav",
      "refersTo": "step-current",
      "description": "Horizontal optional stage commands; the canvas has its own Edit slide command and numbered stage markers are hidden.",
      "html": "<nav class=\"ds-root ds-steps\" aria-label=\"Design stages\"><button class=\"ds-step\" type=\"button\">Start</button><button class=\"ds-step\" type=\"button\" aria-current=\"step\">Slide designs</button><button class=\"ds-step\" type=\"button\">Review &amp; save</button></nav>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-steps{display:flex;flex-wrap:wrap;gap:4px}.ds-step{border:0;background:transparent;padding:8px 12px;font:.85rem/1.25 \"Outfit\",system-ui,sans-serif;border-radius:5px;color:#44536a;min-height:40px;cursor:pointer}.ds-step:hover{background:#e6edf3}.ds-step[aria-current]{background:var(--blue,#004071);color:white}@media(max-width:760px){.ds-step{min-height:44px;padding:8px;font-size:.78rem}}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    },
    {
      "name": "Selected design choice",
      "kind": "button",
      "refersTo": "choice-selected",
      "description": "A pressed decision button retains a selected surface, border, and visible check.",
      "html": "<div class=\"ds-root\"><button class=\"ds-choice\" type=\"button\" aria-pressed=\"true\"><span>Centered</span><svg class=\"ds-check\" width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"m2 6 2.5 2.5L10 3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></button></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-choice{position:relative;min-height:43px;min-width:130px;padding:10px 8px;font:.87rem/1.2 \"Outfit\",system-ui,sans-serif;border:1px solid var(--line,#cad5df);background:var(--paper,#fff);border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:inherit;cursor:pointer}.ds-choice:hover{border-color:var(--action,#007baf)}.ds-choice[aria-pressed=true]{background:#edf5fa;border-color:var(--blue,#004071);font-weight:500}.ds-check{position:absolute;top:4px;right:6px}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    },
    {
      "name": "Selected palette color",
      "kind": "chip",
      "refersTo": "paint-chip-selected",
      "description": "A named circular swatch with selected marker. All approved colors remain visible in the real palette.",
      "html": "<div class=\"ds-root\"><button class=\"ds-paint\" type=\"button\" aria-label=\"Navy selected\" aria-pressed=\"true\"><span class=\"ds-swatch\"><span class=\"ds-mark\"><svg class=\"ds-check\" width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"m2 6 2.5 2.5L10 3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></span></span><span>Navy</span></button></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-paint{border:1px solid transparent;border-radius:5px;padding:4px 2px;background:white;font:.8rem/1.3 \"Outfit\",system-ui,sans-serif;display:flex;align-items:center;flex-direction:column;gap:6px;min-width:60px;cursor:pointer}.ds-paint[aria-pressed=true]{border-color:var(--blue,#004071);background:var(--mist,#edf3f7)}.ds-paint:hover{border-color:#a2b4c5}.ds-swatch{display:block;position:relative;width:44px;height:44px;border-radius:50%;border:1px solid #8191a3;background:var(--blue,#004071)}.ds-mark{position:absolute;bottom:-2px;right:-4px;border-radius:50%;background:var(--navy,#00133f);color:white;display:grid;place-items:center;width:19px;height:19px}@media(max-width:760px){.ds-swatch{width:44px;height:44px}.ds-paint{font-size:.75rem}}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    },
    {
      "name": "Editable preset",
      "kind": "card",
      "refersTo": "preset",
      "description": "A starting-look button samples its actual title palette and heading font.",
      "html": "<div class=\"ds-root\"><button class=\"ds-preset\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-sample\"><i></i><span>Aa</span><b></b></span><strong>Professional</strong><span>Clear structure with a warm accent.</span></button></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-preset{border:1px solid var(--line,#cad5df);padding:0 0 12px;border-radius:6px;overflow:hidden;background:white;display:flex;flex-direction:column;gap:7px;text-align:left;font:.77rem/1.35 \"Outfit\",system-ui,sans-serif;width:210px;cursor:pointer;color:inherit}.ds-preset[aria-pressed=true]{outline:2px solid var(--blue,#004071);outline-offset:1px}.ds-preset>strong,.ds-preset>span:not(.ds-sample){margin:0 10px}.ds-preset strong{font-size:.92rem}.ds-sample{height:84px;width:100%;display:flex;position:relative;align-items:center;background:var(--blue,#004071);color:var(--paper,#fff)}.ds-sample>span{font-family:\"Merriweather\",serif;font-size:2.2rem;z-index:1;margin-left:30px}.ds-sample i{position:absolute;left:0;top:0;bottom:0;width:15px;background:var(--blue,#004071)}.ds-sample b{position:absolute;right:14px;bottom:17px;background:var(--focus,#a7253f);width:33px;height:4px}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    },
    {
      "name": "Slide thumbnails",
      "kind": "nav",
      "refersTo": "preview-tab-selected",
      "description": "A rail of cumulative design thumbnails with selected border and fill; horizontal scrolling on phones.",
      "html": "<div class=\"ds-root ds-tabs\" role=\"tablist\" aria-label=\"Slide preview\"><button type=\"button\" role=\"tab\" aria-selected=\"true\"><span class=\"ds-thumb\"><span>A useful next step</span></span><span class=\"ds-caption\">1. Title slide</span></button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\"><span class=\"ds-thumb\"><span>Put it into practice</span></span><span class=\"ds-caption\">2. Chapter divider</span></button></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-tabs{display:flex;flex-direction:column;gap:12px;width:156px}.ds-tabs button{display:block;width:100%;padding:5px;border:2px solid transparent;border-radius:5px;text-align:left;min-height:44px;font:.8rem \"Outfit\",system-ui,sans-serif;background:transparent;color:var(--muted,#526273);cursor:pointer}.ds-tabs button[aria-selected=true]{border-color:var(--action,#007baf);background:#edf5fa;color:var(--navy,#00133f)}.ds-tabs button:hover{background:#e8edf2}.ds-thumb{display:grid;place-items:center;aspect-ratio:16/10;background:var(--blue,#004071);color:white;padding:8px;font-size:.75rem}.ds-caption{display:block;margin:7px 3px 2px}@media(max-width:760px){.ds-tabs{width:100%;flex-direction:row;gap:8px;overflow-x:auto}.ds-tabs button{flex:0 0 90px;font-size:.7rem}}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    },
    {
      "name": "Contextual native select",
      "kind": "input",
      "refersTo": "contextual-select",
      "description": "The selected element determines a compact row of native controls, with explicit scope beneath.",
      "html": "<div class=\"ds-root ds-toolbar\"><label class=\"ds-field\">Text color<select><option>Navy</option><option>White</option><option>Green</option></select></label><p class=\"ds-scope\">All box headings and title bar \u00b7 Text boxes only.</p></div>",
      "css": ".ds-root{font-family:\"Outfit\",system-ui,sans-serif;color:var(--navy,#00133f)}.ds-toolbar{background:#f2f4f6;padding:14px 0 12px}.ds-field{display:flex;flex-direction:column;gap:5px;font-size:.74rem;color:#526273;width:180px}.ds-field select{max-width:180px;min-width:94px;height:40px;border:1px solid #8f9eaf;background:#fff;border-radius:5px;padding:7px 24px 7px 9px;color:var(--navy,#00133f);font:.88rem \"Outfit\",system-ui,sans-serif}.ds-scope{font-size:.8rem;color:var(--blue,#004071);padding:8px 0 12px;border-bottom:1px solid var(--line,#cad5df)}@media(max-width:760px){.ds-field{width:110px}.ds-field select{width:100%;min-width:0;min-height:44px;font-size:.82rem}.ds-scope{font-size:.75rem}}.ds-root :focus-visible{outline:3px solid var(--focus,#a7253f);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "The SPOKES document editor",
    "overview": "This is the code-defined design system for the editor at `bespoke/index.html`. The explicit form is **Operate**: choose a slide thumbnail, select a visible element, adjust its native contextual controls, and save the complete design. The prescribed document-editor geometry uses the existing SPOKES navy, blue, white, bridge logo, and locally hosted Outfit type. Compact application chrome leaves the cumulative lesson canvas central; More options opens the detailed inspector.\n\nThe interface and the authored lesson design are separate layers. `builder.css` and `guide.css` provide the inherited controls; `direct-editor.css` supplies the current workspace overrides; `direct-editor.mjs` owns transient element selection and contextual controls. `builder-catalog.json` supplies editable choices and `builder-model.mjs` renders the shared lesson model. This document applies to BeSpoke only. It does not restyle the dashboard, original wizard, or released lessons. Root `PRODUCT.md` describes the dashboard and supplies durable SPOKES brand commitments, not this editor's composition. The requested interface was precise; no alternative composition or quality-bar tournament was required.",
    "keyCharacteristics": [
      "Stable SPOKES controls surround a visibly changing, cumulative lesson artifact.",
      "A slide thumbnail rail and selectable canvas make the current design tangible.",
      "Native contextual controls state the affected element and linked editing scope.",
      "More options exposes existing detailed controls, shared defaults, and review.",
      "Mobile retains the canvas with horizontal thumbnail and toolbar scrolling.",
      "State, recovery, readability, and advisory comparison remain near the task they explain."
    ],
    "rules": [
      {
        "name": "The Two Layers Rule",
        "body": "Lesson choices change the shared preview model; they never repaint the builder's navigation, fields, or status surfaces.",
        "section": "colors"
      },
      {
        "name": "The Visible Choice Rule",
        "body": "Keep every approved color visible. Apply the selected color faithfully. Explain contrast in place, include the measured ratio and guideline, and offer alternatives as suggestions. Never require an override checkbox or disguise a selectable color as disabled.",
        "section": "colors"
      },
      {
        "name": "The Independent Type Rule",
        "body": "Preserve both 12-family selectors. Never reintroduce the original wizard's fixed font-pair restrictions.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the SPOKES logo, Outfit chrome, and existing navy-blue-white identity.",
      "Do render previews from the shared model so guided controls, editable presets, and saved designs describe the same artifact.",
      "Do keep all 11 palette choices visible and all 12 font families available independently for headings and body.",
      "Do retain focus, open disclosures, undo history, and recoverable sample text when a choice changes.",
      "Do label sample content, local-test states, contrast repairs, and advisory comparison honestly."
    ],
    "donts": [
      "Don't apply the selected lesson palette or fonts to application chrome.",
      "Don't treat presets as locked themes or restore fixed font-pair restrictions.",
      "Don't disable or cross out low-contrast choices, silently recolor them, or turn contrast advice into a save/build approval requirement.",
      "Don't describe the comparison as a perceptual score or a requirement to pass.",
      "Don't treat a saved design or review request as authorization to build or publish a lesson.",
      "Don't extend this document's authority to the dashboard, original wizard, or released lessons."
    ]
  }
